# Database
WMS_DATABASE_URL=postgresql://postgres:secret@localhost:5432/warehouse_db

# JWT
WMS_JWT_SECRET_KEY=change-me-in-production-use-a-real-secret
WMS_JWT_ALGORITHM=HS256
WMS_JWT_EXPIRATION_MINUTES=480

# MinIO
WMS_MINIO_ENDPOINT=localhost:9000
WMS_MINIO_ACCESS_KEY=minioadmin
WMS_MINIO_SECRET_KEY=minioadmin
WMS_MINIO_BUCKET_NAME=warehouse-receipts
WMS_MINIO_SECURE=false

# Upload
WMS_MAX_UPLOAD_SIZE_MB=10
